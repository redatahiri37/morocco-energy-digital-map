# Secrets — never commit tokens or per-machine config
docs/config.js
.env
.env.*
!.env.example
.dev.vars
.dev.vars.*

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# Claude Code — version the shared team config, ignore per-machine state.
# Must be `.claude/*` not `.claude/`: git cannot re-include a path whose
# parent directory is excluded.
.claude/*
!.claude/agents/
!.claude/launch.json

# Node (if tooling is added later)
node_modules/
npm-debug.log*
yarn-debug.log*

# Python (data-fetch scripts)
__pycache__/
*.pyc
.venv/
venv/
.wrangler/

# Downloads cached by scripts/build-country-open-data.py
scripts/.cache/
