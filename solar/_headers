# Security headers for solar.wattu.org (Cloudflare Pages reads this file;
# solar.yml copies it into the deploy). Code (scripts, styles) comes only
# from this site; the page talks to map tiles, Nominatim, Overpass, our
# Worker and itself (data/cities.json, the city list), nothing else. The 3D
# view (MapLibre, as on the energy map) fetches the Esri tiles itself and
# runs a worker from a blob: URL, hence connect-src Esri, worker-src and
# child-src blob:, img-src blob:. A new host must be added here or the
# browser refuses it. COOP / CORP / X-Frame-Options: no other site can
# frame this page, hold a handle on its window, or embed its files.
# Every refusal is reported to the Worker's /csp (report-to, and report-uri
# for browsers without the Reporting API): SECURITY.md says how to read them.
/*
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data: blob: https://server.arcgisonline.com https://*.tile.openstreetmap.org; font-src 'self'; connect-src 'self' https://nominatim.openstreetmap.org https://overpass-api.de https://solar-pvgis.redatahiri.workers.dev https://server.arcgisonline.com; worker-src blob:; child-src blob:; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests; report-uri https://solar-pvgis.redatahiri.workers.dev/csp; report-to csp
  Reporting-Endpoints: csp="https://solar-pvgis.redatahiri.workers.dev/csp"
  Permissions-Policy: geolocation=(self), camera=(), microphone=(), interest-cohort=()
  Referrer-Policy: strict-origin-when-cross-origin
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Strict-Transport-Security: max-age=31536000

# The chat assistant prototype (chat/, reached by a private link): kept out
# of search engines.
/chat/*
  X-Robots-Tag: noindex, nofollow
