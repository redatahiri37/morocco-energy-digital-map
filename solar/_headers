# Security headers for solar.wattu.org (Cloudflare Pages reads this file;
# solar.yml copies it into the deploy). Code (scripts, styles) comes only
# from this site; the page talks to map tiles, Nominatim, Overpass and our
# Worker, nothing else. A new host must be added here or the browser
# refuses it. COOP / CORP / X-Frame-Options: no other site can frame this
# page, hold a handle on its window, or embed its files.
/*
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data: https://server.arcgisonline.com https://*.tile.openstreetmap.org; font-src 'self'; connect-src https://nominatim.openstreetmap.org https://overpass-api.de https://solar-pvgis.redatahiri.workers.dev; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests
  Permissions-Policy: geolocation=(self), camera=(), microphone=(), interest-cohort=()
  Referrer-Policy: strict-origin-when-cross-origin
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Strict-Transport-Security: max-age=31536000
